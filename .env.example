# Copie pra .env (já ignorado pelo git) e preencha com suas chaves.
# Nenhuma delas exige cartão de crédito no free tier.

# Groq — cadastro em https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (AI Studio) — fallback quando a Groq falhar/estourar limite.
# Cadastro em https://aistudio.google.com/apikey
GEMINI_API_KEY=
